{
  "Function": {
    "prefix": "func",
    "body": [
      "${1:name} : func(${2:params}) -> ${3:void} {",
      "\t$0",
      "}"
    ],
    "description": "Function declaration"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "${1:Name} : struct {",
      "\t${2:field} : ${3:i32}",
      "}"
    ],
    "description": "Struct declaration"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "${1:Name} : enum {",
      "\t${2:Member}",
      "}"
    ],
    "description": "Enum declaration"
  },
  "For-in loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t$0",
      "}"
    ],
    "description": "For-in loop"
  },
  "If block": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If block"
  },
  "If-else block": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If-else block"
  },
  "Import": {
    "prefix": "import",
    "body": "import ${1:package.name}",
    "description": "Import statement"
  },
  "Type alias": {
    "prefix": "alias",
    "body": "${1:Name} : alias ${2:Type}",
    "description": "Type alias"
  },
  "Extension method": {
    "prefix": "ext",
    "body": [
      "@extension",
      "${2:name} : func(self: ^${1:T}) -> ${3:void} {",
      "\t$0",
      "}"
    ],
    "description": "Extension function"
  }
}
